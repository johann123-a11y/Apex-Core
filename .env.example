DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-id-here
# Optional: register commands only to this guild for fast iteration during dev
DISCORD_DEV_GUILD_ID=

# Transcript HTTP server — public URL the Discord link button will use
# e.g. http://YOUR_VPS_IP:3000  (no trailing slash)
TRANSCRIPT_BASE_URL=http://localhost:3000
TRANSCRIPT_PORT=3000
